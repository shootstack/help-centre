{
  "openapi": "3.1.0",
  "info": {
    "title": "Project API",
    "description": "Manage projects within a workspace",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.shootstack.com/v3/app-client"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/projects": {
      "post": {
        "operationId": "createProject",
        "summary": "Create project",
        "description": "Create a new project in the workspace. This also creates an initial [photo folder](/api-reference/photo-folder/overview) and [gallery](/api-reference/gallery/overview) with the same name as the project.\n\nReturns `409 Conflict` if the workspace already has 1,000 projects.",
        "x-mint": {
          "title": "Create project"
        },
        "tags": ["Project"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The project name.",
                    "maxLength": 40,
                    "example": "Smith Wedding"
                  }
                }
              },
              "example": {
                "name": "Smith Wedding"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ProjectBasic"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "507f1f77bcf86cd799439011",
                    "photoFolderIds": [],
                    "galleryIds": [],
                    "cover": null,
                    "name": "Smith Wedding",
                    "status": "no_status",
                    "isFavorite": false,
                    "taskCount": 0,
                    "noteCount": 0,
                    "photoFolderCount": 0,
                    "galleryCount": 0,
                    "galleryShareCount": 0,
                    "photoCount": 0,
                    "photoSize": 0,
                    "updatedAt": "2026-02-16T09:00:00.000Z",
                    "createdAt": "2026-02-16T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "description": "Retrieve a paginated list of projects in the workspace.",
        "x-mint": {
          "title": "List projects"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results per page.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectBasic"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "507f1f77bcf86cd799439011",
                      "photoFolderIds": ["607f1f77bcf86cd799439012"],
                      "galleryIds": ["707f1f77bcf86cd799439013"],
                      "cover": null,
                      "name": "Smith Wedding",
                      "status": "in_progress",
                      "isFavorite": true,
                      "taskCount": 3,
                      "noteCount": 1,
                      "photoFolderCount": 1,
                      "galleryCount": 1,
                      "galleryShareCount": 0,
                      "photoCount": 245,
                      "photoSize": 1048576000,
                      "updatedAt": "2026-02-15T10:30:00.000Z",
                      "createdAt": "2026-01-10T09:00:00.000Z"
                    }
                  ],
                  "pagination": {
                    "totalDocs": 42,
                    "totalPages": 3,
                    "page": 1,
                    "limit": 20,
                    "hasNextPage": true,
                    "hasPrevPage": false
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/projects/search": {
      "get": {
        "operationId": "searchProjects",
        "summary": "Search projects",
        "description": "Search projects by name within the workspace.",
        "x-mint": {
          "title": "Search projects"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search term to filter projects by name.",
            "schema": {
              "type": "string",
              "maxLength": 100,
              "example": "Smith"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results per page.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectSearch"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "507f1f77bcf86cd799439011",
                      "cover": null,
                      "name": "Smith Wedding"
                    }
                  ],
                  "pagination": {
                    "totalDocs": 3,
                    "totalPages": 1,
                    "page": 1,
                    "limit": 20,
                    "hasNextPage": false,
                    "hasPrevPage": false
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/projects/favorites": {
      "get": {
        "operationId": "getFavoriteProjects",
        "summary": "List favorite projects",
        "description": "Retrieve favorite projects in the workspace, sorted by most recently updated. Limited to 10 results.",
        "x-mint": {
          "title": "List favorite projects"
        },
        "tags": ["Project"],
        "responses": {
          "200": {
            "description": "Favorite projects list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectFavorite"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "507f1f77bcf86cd799439011",
                      "cover": null,
                      "name": "Smith Wedding",
                      "isFavorite": true,
                      "updatedAt": "2026-02-15T10:30:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/projects/{project_id}": {
      "get": {
        "operationId": "getProject",
        "summary": "Retrieve project",
        "description": "Retrieve a single project with its photo folders and galleries.",
        "x-mint": {
          "title": "Retrieve project"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Project"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "507f1f77bcf86cd799439011",
                    "photoFolderIds": ["607f1f77bcf86cd799439012"],
                    "galleryIds": ["707f1f77bcf86cd799439013"],
                    "cover": null,
                    "photoFolders": [
                      {
                        "id": "607f1f77bcf86cd799439012",
                        "projectId": "507f1f77bcf86cd799439011",
                        "isWatermarked": false,
                        "name": "Ceremony",
                        "photoCount": 120,
                        "photoSize": 524288000,
                        "updatedAt": "2026-02-14T15:00:00.000Z",
                        "createdAt": "2026-01-10T09:00:00.000Z"
                      }
                    ],
                    "galleries": [
                      {
                        "id": "707f1f77bcf86cd799439013",
                        "projectId": "507f1f77bcf86cd799439011",
                        "name": "Client Gallery",
                        "cover": null,
                        "updatedAt": "2026-02-13T12:00:00.000Z",
                        "createdAt": "2026-01-15T10:00:00.000Z"
                      }
                    ],
                    "name": "Smith Wedding",
                    "status": "in_progress",
                    "isFavorite": true,
                    "taskCount": 3,
                    "noteCount": 1,
                    "photoFolderCount": 1,
                    "galleryCount": 1,
                    "galleryShareCount": 0,
                    "photoCount": 245,
                    "photoSize": 1048576000,
                    "updatedAt": "2026-02-15T10:30:00.000Z",
                    "createdAt": "2026-01-10T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateProject",
        "summary": "Update project",
        "description": "Update an existing project.",
        "x-mint": {
          "title": "Update project"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The project name.",
                    "maxLength": 40,
                    "example": "Smith Wedding 2026"
                  },
                  "status": {
                    "type": "string",
                    "description": "The project status.",
                    "enum": ["no_status", "todo", "in_progress", "done"],
                    "example": "in_progress"
                  },
                  "is_favorite": {
                    "type": "boolean",
                    "description": "Whether the project is marked as a favorite.",
                    "example": true
                  }
                }
              },
              "example": {
                "name": "Smith Wedding 2026",
                "status": "in_progress",
                "is_favorite": true
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Project updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteProject",
        "summary": "Delete project",
        "description": "Delete an existing project and all its associated resources (photo folders, galleries, photos).",
        "x-mint": {
          "title": "Delete project"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Project deleted successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/projects/{project_id}/cover": {
      "patch": {
        "operationId": "updateProjectCover",
        "summary": "Update project cover",
        "description": "Upload or replace the cover image for a project. Returns a pre-signed upload URL.",
        "x-mint": {
          "title": "Update project cover"
        },
        "tags": ["Project"],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "description": "The project ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "content_type", "width", "height", "size"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Original filename of the cover image.",
                    "maxLength": 100,
                    "example": "cover.jpg"
                  },
                  "content_type": {
                    "type": "string",
                    "description": "MIME type of the cover image.",
                    "enum": ["image/jpeg", "image/png", "image/webp", "image/gif"],
                    "example": "image/jpeg"
                  },
                  "width": {
                    "type": "integer",
                    "description": "Image width in pixels.",
                    "minimum": 1,
                    "maximum": 15000,
                    "example": 1920
                  },
                  "height": {
                    "type": "integer",
                    "description": "Image height in pixels.",
                    "minimum": 1,
                    "maximum": 15000,
                    "example": 1080
                  },
                  "size": {
                    "type": "integer",
                    "description": "File size in bytes.",
                    "minimum": 1,
                    "maximum": 100000000,
                    "example": 2048576
                  }
                }
              },
              "example": {
                "name": "cover.jpg",
                "content_type": "image/jpeg",
                "width": 1920,
                "height": 1080,
                "size": 2048576
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload URL and cover metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "uploadUrl": {
                          "type": "string",
                          "description": "Pre-signed URL to upload the cover image."
                        },
                        "cover": {
                          "$ref": "#/components/schemas/Cover"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "uploadUrl": "https://s3.amazonaws.com/bucket/covers/507f1f77bcf86cd799439011.jpg?X-Amz-Signature=...",
                    "cover": {
                      "id": "807f1f77bcf86cd799439014",
                      "sourceKey": "covers/507f1f77bcf86cd799439011.jpg",
                      "name": "cover.jpg",
                      "contentType": "image/jpeg",
                      "width": 1920,
                      "height": 1080,
                      "size": 2048576,
                      "focalPoint": {
                        "x": null,
                        "y": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "description": "Full project object returned by the retrieve endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the project."
          },
          "photoFolderIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of photo folders in this project."
          },
          "galleryIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of galleries in this project."
          },
          "cover": {
            "oneOf": [
              { "$ref": "#/components/schemas/Cover" },
              { "type": "null" }
            ],
            "description": "Cover image metadata, or null if no cover is set."
          },
          "photoFolders": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PhotoFolderItem" },
            "description": "Photo folders belonging to this project."
          },
          "galleries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GalleryItem" },
            "description": "Galleries belonging to this project."
          },
          "name": {
            "type": "string",
            "description": "The project name."
          },
          "status": {
            "type": "string",
            "enum": ["no_status", "todo", "in_progress", "done"],
            "description": "The project status."
          },
          "isFavorite": {
            "type": "boolean",
            "description": "Whether the project is marked as a favorite."
          },
          "taskCount": {
            "type": "integer",
            "description": "Number of tasks in this project."
          },
          "noteCount": {
            "type": "integer",
            "description": "Number of notes in this project."
          },
          "photoFolderCount": {
            "type": "integer",
            "description": "Number of photo folders in this project."
          },
          "galleryCount": {
            "type": "integer",
            "description": "Number of galleries in this project."
          },
          "galleryShareCount": {
            "type": "integer",
            "description": "Number of gallery shares in this project."
          },
          "photoCount": {
            "type": "integer",
            "description": "Total number of photos across all folders."
          },
          "photoSize": {
            "type": "integer",
            "description": "Total photo storage size in bytes."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          }
        }
      },
      "ProjectBasic": {
        "type": "object",
        "description": "Project object returned by list and create endpoints.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the project."
          },
          "photoFolderIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of photo folders in this project."
          },
          "galleryIds": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of galleries in this project."
          },
          "cover": {
            "oneOf": [
              { "$ref": "#/components/schemas/Cover" },
              { "type": "null" }
            ],
            "description": "Cover image metadata, or null if no cover is set."
          },
          "name": {
            "type": "string",
            "description": "The project name."
          },
          "status": {
            "type": "string",
            "enum": ["no_status", "todo", "in_progress", "done"],
            "description": "The project status."
          },
          "isFavorite": {
            "type": "boolean",
            "description": "Whether the project is marked as a favorite."
          },
          "taskCount": {
            "type": "integer",
            "description": "Number of tasks in this project."
          },
          "noteCount": {
            "type": "integer",
            "description": "Number of notes in this project."
          },
          "photoFolderCount": {
            "type": "integer",
            "description": "Number of photo folders in this project."
          },
          "galleryCount": {
            "type": "integer",
            "description": "Number of galleries in this project."
          },
          "galleryShareCount": {
            "type": "integer",
            "description": "Number of gallery shares in this project."
          },
          "photoCount": {
            "type": "integer",
            "description": "Total number of photos across all folders."
          },
          "photoSize": {
            "type": "integer",
            "description": "Total photo storage size in bytes."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          }
        }
      },
      "ProjectSearch": {
        "type": "object",
        "description": "Minimal project object returned by the search endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the project."
          },
          "cover": {
            "oneOf": [
              { "$ref": "#/components/schemas/Cover" },
              { "type": "null" }
            ],
            "description": "Cover image metadata, or null if no cover is set."
          },
          "name": {
            "type": "string",
            "description": "The project name."
          }
        }
      },
      "ProjectFavorite": {
        "type": "object",
        "description": "Project object returned by the favorites endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the project."
          },
          "cover": {
            "oneOf": [
              { "$ref": "#/components/schemas/Cover" },
              { "type": "null" }
            ],
            "description": "Cover image metadata, or null if no cover is set."
          },
          "name": {
            "type": "string",
            "description": "The project name."
          },
          "isFavorite": {
            "type": "boolean",
            "description": "Whether the project is marked as a favorite."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp."
          }
        }
      },
      "Cover": {
        "type": "object",
        "description": "Cover image metadata.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the cover."
          },
          "sourceKey": {
            "type": "string",
            "description": "Storage key for the cover image."
          },
          "name": {
            "type": "string",
            "description": "Original filename."
          },
          "contentType": {
            "type": "string",
            "description": "MIME type of the image."
          },
          "width": {
            "type": "integer",
            "description": "Image width in pixels."
          },
          "height": {
            "type": "integer",
            "description": "Image height in pixels."
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes."
          },
          "focalPoint": {
            "type": "object",
            "description": "Focal point coordinates for cropping.",
            "properties": {
              "x": {
                "type": "number",
                "nullable": true,
                "description": "Horizontal focal point (0-1)."
              },
              "y": {
                "type": "number",
                "nullable": true,
                "description": "Vertical focal point (0-1)."
              }
            }
          }
        }
      },
      "PhotoFolderItem": {
        "type": "object",
        "description": "Photo folder summary within a project.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the photo folder."
          },
          "projectId": {
            "type": "string",
            "description": "ID of the parent project."
          },
          "isWatermarked": {
            "type": "boolean",
