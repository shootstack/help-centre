                    },
                    "data": {
                      "$ref": "#/components/schemas/DeletePhotosResult"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "deletedPhotoCount": 2,
                    "deletedPhotoSize": 16777216
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/move": {
      "post": {
        "operationId": "movePhotos",
        "summary": "Move photos",
        "description": "Move a batch of photos from one photo folder to another.\n\nThe photos are removed from the source folder and added to the target folder. See [Photos](/api-reference/photo/overview) for photo details.\n\n**Limits:** Up to 500 photos per request.\n\nReturns `400 Bad Request` if the target folder is in a different project or is the same as the source folder. Returns `409 Conflict` if the target folder's photo limit would be exceeded.",
        "x-mint": {
          "title": "Move photos"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The source photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target_photo_folder_id", "photo_ids"],
                "properties": {
                  "target_photo_folder_id": {
                    "type": "string",
                    "description": "ID of the destination photo folder."
                  },
                  "photo_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 500,
                    "description": "IDs of the photos to move."
                  }
                }
              },
              "example": {
                "target_photo_folder_id": "617f1f77bcf86cd799439020",
                "photo_ids": [
                  "807f1f77bcf86cd799439014",
                  "807f1f77bcf86cd799439015"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PhotoBatchResult"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "movedPhotoCount": 2,
                    "movedPhotoSize": 16777216
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PhotoFolder": {
        "type": "object",
        "description": "Full photo folder object returned by the retrieve endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the photo folder."
          },
          "projectId": {
            "type": "string",
            "description": "ID of the parent project."
          },
          "isWatermarked": {
            "type": "boolean",
            "description": "Whether photos in this folder have a watermark applied."
          },
          "name": {
            "type": "string",
            "description": "The photo folder name."
          },
          "photoCount": {
            "type": "integer",
            "description": "Number of photos in this folder."
          },
          "photoSize": {
            "type": "integer",
            "description": "Total photo size in bytes."
          },
          "autoSorting": {
            "type": "object",
            "description": "Auto sorting configuration.",
            "properties": {
              "sortBy": {
                "type": "string",
                "enum": ["name", "creationDate"],
