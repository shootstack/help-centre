                      "webHeight": 1600,
                      "webSize": 524288,
                      "creationDate": "2026-01-15T14:30:00.000Z",
                      "uploadDate": "2026-01-20T09:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateSortingPhotos",
        "summary": "Update sorting photos",
        "description": "Reorder photos in a photo folder by providing the photo IDs in the desired order.",
        "x-mint": {
          "title": "Update sorting photos"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["photo_ids"],
                "properties": {
                  "photo_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Ordered list of photo IDs representing the desired sort order."
                  }
                }
              },
              "example": {
                "photo_ids": [
                  "807f1f77bcf86cd799439014",
                  "807f1f77bcf86cd799439015",
