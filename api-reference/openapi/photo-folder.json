{
  "openapi": "3.1.0",
  "info": {
    "title": "Photo Folder API",
    "description": "Manage photo folders within a project",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.shootstack.com/v3/app-client"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/photo-folders": {
      "post": {
        "operationId": "createPhotoFolder",
        "summary": "Create photo folder",
        "description": "Create a new photo folder in a project.\n\nReturns `409 Conflict` if the project already has 25 photo folders.",
        "x-mint": {
          "title": "Create photo folder"
        },
        "tags": ["Photo Folder"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["project_id", "name"],
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "The parent project ID."
                  },
                  "watermark_id": {
                    "type": "string",
                    "description": "ID of the watermark to apply to photos in this folder."
                  },
                  "name": {
                    "type": "string",
                    "description": "The photo folder name.",
                    "maxLength": 40,
                    "example": "Ceremony"
                  },
                  "manual_sorting": {
                    "type": "boolean",
                    "description": "Whether to enable manual sorting.",
                    "example": false
                  }
                }
              },
              "example": {
                "project_id": "507f1f77bcf86cd799439011",
                "name": "Ceremony"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Photo folder created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PhotoFolderBasic"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "607f1f77bcf86cd799439012",
                    "projectId": "507f1f77bcf86cd799439011",
                    "isWatermarked": false,
                    "name": "Ceremony",
                    "photoCount": 0,
                    "photoSize": 0,
                    "updatedAt": "2026-02-17T09:00:00.000Z",
                    "createdAt": "2026-02-17T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}": {
      "get": {
        "operationId": "getPhotoFolder",
        "summary": "Retrieve photo folder",
        "description": "Retrieve a single photo folder with its sorting configuration.",
        "x-mint": {
          "title": "Retrieve photo folder"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Photo folder object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PhotoFolder"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "607f1f77bcf86cd799439012",
                    "projectId": "507f1f77bcf86cd799439011",
                    "isWatermarked": false,
                    "name": "Ceremony",
                    "photoCount": 120,
                    "photoSize": 524288000,
                    "autoSorting": {
                      "sortBy": "creationDate",
                      "sortOrder": "asc"
                    },
                    "manualSorting": false,
                    "updatedAt": "2026-02-16T15:00:00.000Z",
                    "createdAt": "2026-01-10T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updatePhotoFolder",
        "summary": "Update photo folder",
        "description": "Update an existing photo folder.",
        "x-mint": {
          "title": "Update photo folder"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The photo folder name.",
                    "maxLength": 40,
                    "example": "Reception"
                  }
                }
              },
              "example": {
                "name": "Reception"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Photo folder updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deletePhotoFolder",
        "summary": "Delete photo folder",
        "description": "Delete an existing photo folder and all its photos.",
        "x-mint": {
          "title": "Delete photo folder"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Photo folder deleted successfully"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/auto-sorting": {
      "patch": {
        "operationId": "updateAutoSorting",
        "summary": "Update auto sorting",
        "description": "Update the automatic sorting configuration for a photo folder.",
        "x-mint": {
          "title": "Update auto sorting"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sort_by": {
                    "type": "string",
                    "description": "Field to sort photos by.",
                    "enum": ["name", "creationDate"],
                    "example": "creationDate"
                  },
                  "sort_order": {
                    "type": "string",
                    "description": "Sort direction.",
                    "enum": ["asc", "desc"],
                    "example": "asc"
                  }
                }
              },
              "example": {
                "sort_by": "creationDate",
                "sort_order": "asc"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Auto sorting updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/manual-sorting": {
      "patch": {
        "operationId": "updateManualSorting",
        "summary": "Update manual sorting",
        "description": "Enable or disable manual sorting for a photo folder.\n\nReturns `409 Conflict` if enabling manual sorting would exceed the 500 sorting photo limit.",
        "x-mint": {
          "title": "Update manual sorting"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["manual_sorting"],
                "properties": {
                  "manual_sorting": {
                    "type": "boolean",
                    "description": "Whether to enable manual sorting.",
                    "example": true
                  }
                }
              },
              "example": {
                "manual_sorting": true
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Manual sorting updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/sorting-photos": {
      "get": {
        "operationId": "getSortingPhotos",
        "summary": "List sorting photos",
        "description": "Retrieve photos in a photo folder for sorting purposes.",
        "x-mint": {
          "title": "List sorting photos"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
