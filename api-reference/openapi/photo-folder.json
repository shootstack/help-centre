                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sorting photos updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/duplicate": {
      "post": {
        "operationId": "duplicatePhotoFolder",
        "summary": "Duplicate photo folder",
        "description": "Duplicate a photo folder and all its photos into the same project.\n\n**Limits:** Up to 500 photos per folder.\n\nReturns `409 Conflict` if the project already has 25 photo folders or the folder has more than 500 photos.",
        "x-mint": {
          "title": "Duplicate photo folder"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The photo folder ID to duplicate.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name for the new photo folder. Defaults to the original name with a copy suffix.",
                    "maxLength": 40,
                    "example": "Ceremony (Copy)"
                  },
                  "watermark_id": {
                    "type": "string",
                    "description": "ID of the watermark to apply to photos in the new folder."
                  }
                }
              },
              "example": {
                "name": "Ceremony (Copy)"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Duplicated photo folder",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PhotoFolderBasic"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "id": "617f1f77bcf86cd799439099",
                    "projectId": "507f1f77bcf86cd799439011",
                    "isWatermarked": false,
                    "name": "Ceremony (Copy)",
                    "photoCount": 120,
                    "photoSize": 524288000,
                    "updatedAt": "2026-02-21T09:00:00.000Z",
                    "createdAt": "2026-02-21T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/photo-folders/{photo_folder_id}/copy": {
      "post": {
        "operationId": "copyPhotos",
        "summary": "Copy photos",
        "description": "Copy a batch of photos from one photo folder to another.\n\nThe original photos remain in the source folder. The copied photos are created as new records in the target folder and inherit the original file data. See [Photos](/api-reference/photo/overview) for photo details.\n\n**Limits:** Up to 500 photos per request.\n\nReturns `400 Bad Request` if the target folder is in a different project or is the same as the source folder. Returns `409 Conflict` if the target folder's photo limit would be exceeded.",
        "x-mint": {
          "title": "Copy photos"
        },
        "tags": ["Photo Folder"],
        "parameters": [
          {
            "name": "photo_folder_id",
            "in": "path",
            "required": true,
            "description": "The source photo folder ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["target_photo_folder_id", "photo_ids"],
                "properties": {
                  "target_photo_folder_id": {
                    "type": "string",
                    "description": "ID of the destination photo folder."
                  },
                  "photo_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 500,
                    "description": "IDs of the photos to copy."
                  }
                }
              },
              "example": {
                "target_photo_folder_id": "617f1f77bcf86cd799439020",
                "photo_ids": [
                  "807f1f77bcf86cd799439014",
                  "807f1f77bcf86cd799439015"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copy result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PhotoBatchResult"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "copiedPhotoCount": 2,
                    "copiedPhotoSize": 16777216
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
