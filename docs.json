{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "maple",
    "name": "Shootstack Help",
    "colors": {
        "primary": "#71717b",
        "light": "#F4F4F5",
        "dark": "#0E0E10"
    },
    "favicon": "/favicon.svg",
    "navigation": {
        "global": {
            "anchors": [
                {
                    "anchor": "App",
                    "icon": "grid-2",
                    "href": "https://app.shootstack.com"
                },
                {
                    "anchor": "Website",
                    "icon": "globe",
                    "href": "https://shootstack.com"
                }
            ]
        },
        "tabs": [
            {
                "tab": "Help center",
                "groups": [
                    {
                        "group": "Getting started",
                        "pages": ["index", "getting-started/welcome"]
                    }
                ]
            }
        ]
    },
    "logo": {
        "light": "/logo/dark.svg",
        "dark": "/logo/light.svg"
    },
    "navbar": {
        "primary": {
            "type": "button",
            "label": "Open app",
            "href": "https://app.shootstack.com"
        }
    },
    "contextual": {
        "options": ["copy", "view", "chatgpt", "claude"]
    },
    "footer": {
        "socials": {
            "github": "https://github.com/shootstack",
            "website": "https://shootstack.com"
        }
    },
    "seo": {
        "indexing": "navigable"
    },
    "description": "Help and guides for Shootstack customers.",
    "background": {
        "decoration": "gradient",
        "color": {
            "light": "#fff",
            "dark": "#000"
        }
    },
    "appearance": {
        "default": "system"
    }
}
